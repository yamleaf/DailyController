<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ShapeAppearance 圆角体系（收敛到 protocol 令牌阶梯，与 DT 协同） -->
    <style name="ShapeAppearance.DC.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/dp_4</item>
    </style>
    <style name="ShapeAppearance.DC.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/radius_pill</item>
    </style>
    <style name="ShapeAppearance.DC.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_dialog</item>
    </style>
    <style name="ShapeAppearance.DC.XL" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_nav_card</item>
    </style>
    <style name="ShapeAppearance.DC.Full" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_floating_nav</item>
    </style>

    <style name="Theme.DailyController" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_onTertiary</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_onError</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outlineVariant</item>
        <!-- 波纹色（品牌蓝 8%）替代系统默认灰 -->
        <item name="android:colorControlHighlight">@color/color_ripple</item>
        <!-- 统一 Snackbar（§3.16） -->
        <item name="snackbarStyle">@style/Widget.Daily.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/TextAppearance.Daily.Snackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.Daily.Snackbar.Action</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="android:windowBackground">@color/md_background</item>
        <!-- 透明状态栏：顶栏渐变延伸到状态栏区域，内容靠 AppBar padding 避开重叠 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- 统一对话框主题（28dp 圆角 + 胶囊按钮，双端共用 :protocol 弹窗体系） -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Daily.UnifiedDialog</item>
        <!-- 底部面板主题（顶部 24dp 圆角） -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.DC.BottomSheetDialog</item>
        <!-- 窗口转场：用系统合成（自动尊重系统「减少动态效果」缩放），替代已弃用的 overridePendingTransition -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@transition/fade</item>
        <item name="android:windowExitTransition">@transition/fade</item>
        <item name="android:windowReenterTransition">@transition/fade</item>
        <item name="android:windowReturnTransition">@transition/fade</item>
    </style>

    <!-- 底部面板：仅顶部 24dp 圆角（统一规范） -->
    <style name="ShapeAppearance.DC.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- 弹窗入场/出场动画（scale + fade，200ms / 150ms） -->
    <style name="Animation.DC.DialogScale" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <!-- 统一输入框样式（10dp 圆角，双端一致） -->
    <style name="ShapeAppearance.DC.Input" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_input</item>
    </style>
    <style name="Widget.DC.TextInput.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.DC.Input</item>
    </style>

    <!-- 底部面板主题 -->
    <style name="ThemeOverlay.DC.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.DC.BottomSheet</item>
        <item name="backgroundTint">@color/md_surface</item>
        <item name="android:windowAnimationStyle">@style/Animation.DC.DialogScale</item>
    </style>
</resources>
