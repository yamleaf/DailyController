<?xml version="1.0" encoding="utf-8"?>
<!-- 分组选中态：品牌色渐变 + 柔和投影，营造「胶囊选中」层次感 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#1A5B5BD6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/md_primary"
                android:endColor="@color/header_end" />
        </shape>
    </item>
</layer-list>