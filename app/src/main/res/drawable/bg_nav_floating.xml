<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 柔和投影：自绘，避开 MaterialCardView 阴影被渲染成白块的问题 -->
    <item
        android:left="0dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 表面卡片：圆角 + 细描边，作为悬浮容器 -->
    <item
        android:left="2dp"
        android:top="0dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/md_outlineVariant" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</layer-list>
