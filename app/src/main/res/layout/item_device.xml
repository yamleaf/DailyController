<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="@color/md_surface"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/md_outlineVariant"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 左侧渐变强调条 -->
        <View
            android:id="@+id/accentBar"
            android:layout_width="5dp"
            android:layout_height="0dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_header_gradient"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imgDeviceIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_primary"
            android:padding="12dp"
            android:src="@drawable/ic_device"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/accentBar"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/md_onPrimaryContainer" />

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_onSurface"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/dotOnline"
            app:layout_constraintStart_toEndOf="@id/imgDeviceIcon"
            app:layout_constraintTop_toTopOf="@id/imgDeviceIcon" />

        <TextView
            android:id="@+id/tvDeviceId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="3dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/md_onSurfaceVariant"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/dotOnline"
            app:layout_constraintStart_toEndOf="@id/imgDeviceIcon"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceName" />

        <View
            android:id="@+id/dotOnline"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_dot_offline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgChevron"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 状态灯高光：白色径向光泽叠在 dotOnline 左上角，使其从扁平圆点变为球面质感（固定白色，不参与状态 tint） -->
        <View
            android:id="@+id/dotGloss"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot_gloss"
            app:layout_constraintStart_toStartOf="@id/dotOnline"
            app:layout_constraintTop_toTopOf="@id/dotOnline" />

        <ImageView
            android:id="@+id/imgChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/md_outline" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
