<?xml version="1.0" encoding="utf-8"?>
<!--
  任务卡片长按弹层：底部上滑风格。

  与左滑的职责分工（避免功能 100% 重复）：
  - 左滑 = 快捷操作（明确知道自己要做什么，一步到位）
  - 长按 = 先看全信息，再决定操作（卡片上被省略/压缩的信息在这里完整呈现）

  因此弹层上半部分是「任务详情」只读区（完整时间 / 随机窗口 / 实际执行 / 完整备注 + 复制时间），
  下半部分才是编辑、删除操作。色块 / 圆角 / 手柄均与 sheet_select_workday 保持一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_20"
    android:paddingEnd="@dimen/dp_20"
    android:paddingBottom="@dimen/dp_20">

    <!-- 顶部手柄 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/dp_32"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_16"
        app:cardBackgroundColor="@color/md_outline"
        app:cardCornerRadius="2dp"
        app:strokeWidth="0dp" />

    <!-- 标题行：标题 + 状态胶囊（状态原先只在卡片右侧的小胶囊上，这里给出完整标签） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="任务详情"
            android:textColor="@color/md_onSurface"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/dp_10"
            android:paddingVertical="4dp"
            android:textColor="@color/md_primary"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            tools:text="待执行" />
    </LinearLayout>

    <!-- 详情只读区：完整信息（卡片上备注单行省略、状态只有短标签） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_14"
        android:background="@drawable/bg_task_sub_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_14"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_6">

        <!-- 打卡时间（右侧「复制」按钮：把时间点复制到剪贴板，长按独有的能力） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="60dp"
                android:text="打卡时间"
                android:textColor="@color/md_onSurfaceVariant"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tvDetailTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/md_onSurface"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                tools:text="08:23:00" />

            <FrameLayout
                android:id="@+id/btnCopyTime"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:layout_marginStart="@dimen/dp_2"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/md_primary" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_outlineVariant" />

        <!-- 随机窗口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="60dp"
                android:text="随机窗口"
                android:textColor="@color/md_onSurfaceVariant"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tvDetailRandomWindow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/md_onSurface"
                android:textSize="@dimen/sp_13"
                tools:text="08:23 - 08:27" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_outlineVariant" />

        <!-- 实际执行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="60dp"
                android:text="实际执行"
                android:textColor="@color/md_onSurfaceVariant"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tvDetailActual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/md_onSurface"
                android:textSize="@dimen/sp_13"
                tools:text="08:24:31" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_outlineVariant" />

        <!-- 任务备注：卡片上单行省略，这里最多 3 行完整展示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="60dp"
                android:text="任务备注"
                android:textColor="@color/md_onSurfaceVariant"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="3"
                android:textColor="@color/md_onSurface"
                android:textSize="@dimen/sp_13"
                tools:text="早班打卡（工作日 8:20 前完成）" />
        </LinearLayout>
    </LinearLayout>

    <!-- 编辑操作卡 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActionEdit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_56"
        android:layout_marginTop="@dimen/dp_16"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/md_primaryContainer"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_14">

            <FrameLayout
                android:layout_width="@dimen/size_40"
                android:layout_height="@dimen/size_40"
                android:background="@drawable/bg_circle_primary">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/md_onPrimaryContainer"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="编辑任务"
                    android:textColor="@color/md_onSurface"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="修改打卡时间或备注"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="@dimen/sp_11" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/md_primary"
                android:contentDescription="@null" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 删除操作卡 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActionDelete"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_56"
        android:layout_marginTop="@dimen/dp_8"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/md_warningContainer"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_14">

            <FrameLayout
                android:layout_width="@dimen/size_40"
                android:layout_height="@dimen/size_40"
                android:background="@drawable/bg_circle_tertiary">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/md_error"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="删除任务"
                    android:textColor="@color/md_onSurface"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="移除该打卡时间点"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="@dimen/sp_11" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/md_error"
                android:contentDescription="@null" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActionCancel"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_48"
        android:layout_marginTop="@dimen/dp_16"
        android:text="取消"
        android:textColor="@color/md_onSurfaceVariant"
        app:cornerRadius="12dp"
        app:strokeColor="@color/md_outline" />

</LinearLayout>
