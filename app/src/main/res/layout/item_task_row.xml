<?xml version="1.0" encoding="utf-8"?>
<!--
  DC 任务卡片：一个任务一张独立卡片。
  根节点 SwipeRevealLayout 约定：第 1 个子 View = 左滑露出的操作面板，第 2 个子 View = 内容卡片。
  色块 / 圆角 / 按压反馈 / 卡片描边均与设备列表 item_device.xml 保持同一套规范。
-->
<com.yample.daily.controller.widget.SwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRevealLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!--
      左滑操作面板：一叠斜放的小卡片（层层错位堆叠）。
      两卡都是 72×88dp 的固定尺寸、垂直居中，不撑满整行高度（避免"大木板"观感）。
      两卡水平错开由代码的 translationX 驱动，仅留约 6dp 重叠 —— 各自文字完整可见、各自可点。
      面板总宽 150dp = 内容层最大左移距离。
    -->
    <FrameLayout
        android:id="@+id/actionPanel"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:clipChildren="false">

        <!-- 底层：删除卡（右、下沉、顺时针倾斜） -->
        <TextView
            android:id="@+id/btnActionDelete"
            android:layout_width="72dp"
            android:layout_height="88dp"
            android:layout_gravity="center_vertical|end"
            android:elevation="1dp"
            android:background="@drawable/bg_task_action_delete"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_2"
            android:text="@string/action_delete"
            android:textColor="@android:color/white"
            android:textSize="@dimen/sp_13"
            android:textStyle="bold" />

        <!-- 上层：编辑卡（左、上浮、逆时针倾斜），水平错开 66dp -->
        <TextView
            android:id="@+id/btnActionEdit"
            android:layout_width="72dp"
            android:layout_height="88dp"
            android:layout_gravity="center_vertical|end"
            android:elevation="2dp"
            android:background="@drawable/bg_task_action_edit"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_2"
            android:text="@string/action_edit"
            android:textColor="@android:color/white"
            android:textSize="@dimen/sp_13"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- 内容层：任务卡片（外层页面不再套大卡片，避免卡片嵌套） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/md_surface"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_outlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_16">

            <!-- 首行：任务执行时间 + 备注（无备注保持空位）+ 状态胶囊 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTaskTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/md_onSurface"
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold"
                    tools:text="08:23:00" />

                <!-- 备注：无备注时文本留空、控件保留，行高与布局保持稳定 -->
                <TextView
                    android:id="@+id/tvTaskName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="@dimen/sp_13"
                    tools:text="早班打卡" />

                <TextView
                    android:id="@+id/tvTaskStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:background="@drawable/bg_status_pill"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:paddingVertical="4dp"
                    android:textColor="@color/md_primary"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold"
                    tools:text="待执行" />

            </LinearLayout>

            <!-- 第二行：两张淡灰小卡片，左随机窗口 / 右实际执行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardRandomWindow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_task_sub_card"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="随机窗口"
                        android:textColor="@color/md_onSurfaceVariant"
                        android:textSize="@dimen/sp_12" />

                    <TextView
                        android:id="@+id/tvTaskRandomWindow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_6"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/md_onSurface"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold"
                        tools:text="08:23 - 08:28" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardActualTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_task_sub_card"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="实际执行"
                        android:textColor="@color/md_onSurfaceVariant"
                        android:textSize="@dimen/sp_12" />

                    <TextView
                        android:id="@+id/tvTaskActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_6"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/md_onSurface"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold"
                        tools:text="--:--:--" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</com.yample.daily.controller.widget.SwipeRevealLayout>
