<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView 
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_circle_tertiary"
        android:padding="8dp"
        android:src="@drawable/ic_timer"
        app:tint="@color/md_onTertiaryContainer" android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTaskTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_onSurface"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvTaskName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/md_onSurfaceVariant"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTaskSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="打卡时间点"
            android:textColor="@color/md_onSurfaceVariant"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTaskStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="待执行"
        android:textColor="@color/md_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnEditTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="编辑"
        android:textColor="@color/md_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDeleteTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="删除"
        android:textColor="@color/md_error"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
