<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 链式轨道列：节点圆底图标 + 上下连线（连线由 TaskChainDecoration 绘制） -->
    <FrameLayout
        android:id="@+id/chainTrack"
        android:layout_width="40dp"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/chainDot"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_tertiary">

            <ImageView
                android:id="@+id/imgTaskIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@drawable/ic_timer"
                app:tint="@color/md_onTertiaryContainer"
                android:contentDescription="@null" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTaskTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_onSurface"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvTaskName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/md_onSurfaceVariant"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTaskSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="打卡时间点"
            android:textColor="@color/md_onSurfaceVariant"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTaskStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="待执行"
        android:textColor="@color/md_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditTask"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:minHeight="@dimen/size_48"
        android:text="编辑"
        android:textColor="@color/md_primary"
        android:textStyle="bold"
        android:textSize="13sp"
        app:cornerRadius="@dimen/radius_pill" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteTask"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:minHeight="@dimen/size_48"
        android:text="删除"
        android:textColor="@color/md_error"
        android:textStyle="bold"
        android:textSize="13sp"
        app:cornerRadius="@dimen/radius_pill" />

</LinearLayout>
