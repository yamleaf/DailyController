<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/on_header"
            app:subtitleTextColor="@color/on_header"
            app:title="设备控制"
            app:titleTextColor="@color/on_header" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/offlineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/md_warningContainer"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/md_warning" android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvOfflineBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="设备离线，数据可能不是最新"
                    android:textColor="@color/md_onWarningContainer"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═════ Fragment 容器（全屏，无底边距；导航栏以 overlay 覆盖） ═════ -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- ═════ 悬浮导航栏（overlay，5 项均等分布，自绘圆角投影卡片） ═════ -->
    <LinearLayout
        android:id="@+id/navCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:background="@drawable/bg_nav_floating">

        <!-- ── ① 日历 ── -->
        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iconCalendar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="日历" />

            <TextView
                android:id="@+id/labelCalendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="日历"
                android:textSize="11sp"
                android:textColor="@color/md_onSurfaceVariant" />

            <View
                android:id="@+id/lineCalendar"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/md_primary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── ② 任务 ── -->
        <LinearLayout
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iconTasks"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_timer"
                android:contentDescription="任务" />

            <TextView
                android:id="@+id/labelTasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="任务"
                android:textSize="11sp"
                android:textColor="@color/md_onSurfaceVariant" />

            <View
                android:id="@+id/lineTasks"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/md_primary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── ③ 总览 ── -->
        <LinearLayout
            android:id="@+id/navOverview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iconOverview"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_overview"
                android:contentDescription="总览" />

            <TextView
                android:id="@+id/labelOverview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="总览"
                android:textSize="11sp"
                android:textColor="@color/md_onSurfaceVariant" />

            <View
                android:id="@+id/lineOverview"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/md_primary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── ④ 设备 ── -->
        <LinearLayout
            android:id="@+id/navDevice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iconDevice"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_device"
                android:contentDescription="设备" />

            <TextView
                android:id="@+id/labelDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="设备"
                android:textSize="11sp"
                android:textColor="@color/md_onSurfaceVariant" />

            <View
                android:id="@+id/lineDevice"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/md_primary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── ⑤ 设置 ── -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iconSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="设置" />

            <TextView
                android:id="@+id/labelSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="设置"
                android:textSize="11sp"
                android:textColor="@color/md_onSurfaceVariant" />

            <View
                android:id="@+id/lineSettings"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/md_primary"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
