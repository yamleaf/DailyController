<?xml version="1.0" encoding="utf-8"?>
<!--
  Serverless 后端配置弹窗（v1.2 重构）
  结构：基础信息分组 → 连接信息分组（标题和按钮由 showForm 统一管理）
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="基础信息"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/md_primary"
        android:letterSpacing="0.04" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Daily.TextInput.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="后台名称"
        app:startIconDrawable="@drawable/ic_dialog_info"
        app:startIconTint="@color/md_primary"
        app:helperText="用于区分多个后台，如「办公打卡」「外勤打卡」"
        app:helperTextEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="连接信息"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/md_primary"
        android:letterSpacing="0.04" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Daily.TextInput.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="API 地址"
        app:startIconDrawable="@drawable/ic_dialog_info"
        app:startIconTint="@color/md_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Daily.TextInput.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="AppID"
        app:startIconDrawable="@drawable/ic_dialog_info"
        app:startIconTint="@color/md_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAppId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Daily.TextInput.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:hint="AppSecret"
        app:startIconDrawable="@drawable/ic_dialog_info"
        app:startIconTint="@color/md_primary"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAppSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>