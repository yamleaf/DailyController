<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ 1. 设备卡片（身份锚点，置顶） ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/md_outlineVariant"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imgDeviceIcon"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_circle_primary"
                    android:padding="14dp"
                    android:src="@drawable/ic_device"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/md_onPrimaryContainer" />

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/md_onSurface"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/dotStatus"
                    app:layout_constraintStart_toEndOf="@id/imgDeviceIcon"
                    app:layout_constraintTop_toTopOf="@id/imgDeviceIcon" />

                <TextView
                    android:id="@+id/tvDeviceSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imgDeviceIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvDeviceName" />

                <!-- 状态灯：halo(同色光晕) + dotStatus(实心)，颜色随连接状态变化。
                     定位在设备名称右侧、与名称垂直居中对齐，marginEnd=14dp 远离卡片圆角避免被裁切 -->
                <View
                    android:id="@+id/dotHalo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:alpha="0.3"
                    android:background="@drawable/bg_dot_offline"
                    app:layout_constraintBottom_toBottomOf="@id/dotStatus"
                    app:layout_constraintEnd_toEndOf="@id/dotStatus"
                    app:layout_constraintStart_toStartOf="@id/dotStatus"
                    app:layout_constraintTop_toTopOf="@id/dotStatus" />

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_dot_offline"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintBottom_toBottomOf="@id/tvDeviceName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvDeviceName" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 需求：设备卡状态灯颜色图例（小字说明） -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/md_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/md_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_dot_offline"
                            android:backgroundTint="#16A34A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="在线"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_dot_offline"
                            android:backgroundTint="#F59E0B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="配对中"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_dot_offline"
                            android:backgroundTint="#9CA3AF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="离线/解绑"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_dot_offline"
                            android:backgroundTint="#DC2626" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="失败"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- D5：未配对时显示「重新配对」入口（配对令牌 2 分钟有效） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRePair"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="重新配对（配对令牌 2 分钟内有效）"
            android:visibility="gone"
            app:icon="@drawable/ic_scan"
            app:iconTint="@color/md_primary" />

        <!-- D3：缓存数据可能已过期的灰色细条提示 -->
        <TextView
            android:id="@+id/tvStaleStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/md_surfaceVariant"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="缓存数据 · 可能已过期"
            android:textColor="@color/md_onSurfaceVariant"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ============ 2. 连接与控制 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/md_outlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_circle_primary"
                        android:padding="10dp"
                        android:src="@drawable/ic_power"
                        app:tint="@color/md_onPrimaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MQTT 连接"
                            android:textColor="@color/md_onSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="关闭后不再发起任何 MQTT 请求（包括快照）"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchRemote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Divider" android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSnapshotHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="start"
                        android:text="未获取到快照：点击「刷新实时数据」获取最新状态"
                        android:textColor="@color/md_onSurfaceVariant"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRefresh"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="实时刷新"
                            app:icon="@drawable/ic_timer"
                            app:iconTint="@color/md_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReconnect"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="重新连接"
                            app:icon="@drawable/ic_power"
                            app:iconTint="@color/md_primary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 3. 快捷操作 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/md_outlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="快捷操作"
                    android:textColor="@color/md_onSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="远程触发被控端动作（结果经被控端消息渠道回传）"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActPunch"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="打卡"
                        app:icon="@drawable/ic_device"
                        app:iconTint="@color/md_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActAttendance"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="考勤记录"
                        app:icon="@drawable/ic_scan"
                        app:iconTint="@color/md_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActStart"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="执行任务"
                        app:icon="@drawable/ic_power"
                        app:iconTint="@color/md_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActStop"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="终止任务"
                        app:icon="@drawable/ic_power_save"
                        app:iconTint="@color/md_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 4. 运行概览 ============ -->
        <TextView style="@style/SectionTitle" android:text="运行概览" />

        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                style="@style/SectionBody"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_circle_secondary"
                        android:padding="10dp"
                        android:src="@drawable/ic_power_save"
                        app:tint="@color/md_onSecondaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvBatteryPct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textColor="@color/md_onSurface"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBatteryCharging"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="--"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBattery"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:progress="0"
                        app:indicatorColor="@color/md_primary"
                        app:trackColor="@color/md_surfaceVariant"
                        app:trackThickness="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/chipForeground"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="前台服务" />

                    <TextView
                        android:id="@+id/chipScheduler"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="任务调度" />

                    <TextView
                        android:id="@+id/chipPowerSave"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="省电模式" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/chipPseudo"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="伪息屏" />

                    <TextView
                        android:id="@+id/chipWifi"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="WiFi" />

                    <TextView
                        android:id="@+id/chipBluetooth"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="蓝牙" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/chipNextReset"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="下次重置" />

                    <TextView
                        android:id="@+id/chipServiceRun"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="运行时长" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <include layout="@layout/row_info" android:id="@+id/rowSchedulerDesc" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowDeviceTime" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowTemperature" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 5. 电池趋势 ============ -->
        <TextView style="@style/SectionTitle" android:text="电池趋势" />
        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                style="@style/SectionBody"
                android:orientation="vertical">

                <com.yample.daily.controller.BatterySparkView
                    android:id="@+id/batterySpark"
                    android:layout_width="match_parent"
                    android:layout_height="96dp" />

                <TextView
                    android:id="@+id/tvBatteryTrend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="—"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 6. 最近指令 ============ -->
        <TextView style="@style/SectionTitle" android:text="最近指令" />
        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                android:id="@+id/layoutRecentCmds"
                style="@style/SectionBody"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 7. 打卡概览 ============ -->
        <TextView style="@style/SectionTitle" android:text="打卡概览" />
        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                style="@style/SectionBody"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/tvPunchPunched" style="@style/StatNum" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="已打卡" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/tvPunchScheduled" style="@style/StatNum" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="计划" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/tvPunchMissed" style="@style/StatNum" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="未计划" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/SectionBody" android:layout_marginTop="12dp">
                    <include layout="@layout/row_info" android:id="@+id/rowNext" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowRecent" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowToday" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 8. 技术详情（低频访问，折叠收起） ============ -->
        <TextView style="@style/SectionTitle" android:text="技术详情" />

        <!-- 连接信息（C1：可折叠，默认收起） -->
        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                style="@style/SectionBody"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnToggleConn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="连接信息"
                        android:textColor="@color/md_onSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuotaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="—"
                        android:textColor="@color/md_onSurfaceVariant"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/ivChevronConn"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/md_outline" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bodyConn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include layout="@layout/row_info" android:id="@+id/rowBroker" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowDeviceId" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowClientId" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowPaired" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowSynced" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowConnQuality" />

                    <!-- 需求 4：原「MQTT 状态」卡片内容并入连接信息 -->
                    <View style="@style/Divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="消息统计"
                        android:textColor="@color/md_onSurface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressQuota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="0"
                        android:visibility="gone"
                        app:indicatorColor="@color/md_primary"
                        app:trackColor="@color/md_surfaceVariant"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/tvQuotaHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="本地统计：已发送 + 已接收消息数"
                        android:textColor="@color/md_onSurfaceVariant"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/layoutQuotaDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 设备信息（C1：可折叠，默认收起） -->
        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                style="@style/SectionBody"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnToggleDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="设备信息"
                        android:textColor="@color/md_onSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivChevronDevice"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/md_outline" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bodyDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <include layout="@layout/row_info" android:id="@+id/rowModel" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowBrand" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowAndroid" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowApp" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowScreen" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowInstall" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 最近打卡记录 -->
        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                android:id="@+id/layoutHistory"
                style="@style/SectionBody"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnbind"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="解绑设备"
            android:textColor="@color/md_onError"
            app:backgroundTint="@color/md_error" />

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
