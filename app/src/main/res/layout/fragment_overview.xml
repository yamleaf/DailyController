<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="100dp">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 探活骨架屏：进入详情页发 snapshot 探活（最坏 ~4s）期间显示，首帧到达淡出 -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressProbe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/md_primary"
                app:trackColor="@color/md_surfaceVariant" />

        <!-- ============ 1. Hero 设备状态卡（白底简洁版：设备详情聚焦） ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_outlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_20">

                <!-- 解绑态专属：重新配对入口（置顶显示，浅色背景 + 呼吸描边） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRePair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:text="重新配对"
                    android:visibility="gone"
                    app:backgroundTint="@color/md_primaryContainer"
                    app:cornerRadius="@dimen/dp_12"
                    app:icon="@drawable/ic_device"
                    app:iconGravity="textStart"
                    app:iconTint="@color/re_pair_accent"
                    app:strokeColor="@color/re_pair_accent"
                    app:strokeWidth="1.5dp"
                    android:textColor="@color/re_pair_accent" />

                <!-- 第一行：图标 + 设备名/副标题 + 状态灯 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/size_48"
                        android:layout_height="@dimen/size_48"
                        android:background="@drawable/bg_hero_icon_box">

                        <ImageView
                            android:id="@+id/imgDeviceIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_device"
                            android:contentDescription="@null"
                            app:tint="@color/md_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDeviceName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="未连接设备"
                            android:textColor="@color/md_onSurface"
                            android:textSize="@dimen/sp_19"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDeviceSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="等待被控端上线…"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="@dimen/sp_13" />
                    </LinearLayout>

                    <!-- 右侧：状态灯（dot + gloss） -->
                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="@dimen/dp_4">

                        <View
                            android:id="@+id/dotStatus"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_dot_offline"
                            android:foreground="?attr/selectableItemBackgroundBorderless" />

                        <View
                            android:id="@+id/dotGloss"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:alpha="1.0"
                            android:background="@drawable/bg_dot_gloss"
                            android:clickable="false"
                            android:focusable="false" />
                    </FrameLayout>
                </LinearLayout>

                <!-- MQTT 连接开关行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/size_40"
                        android:layout_height="@dimen/size_40"
                        android:background="@drawable/bg_circle_primary">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_power"
                            android:contentDescription="@null"
                            app:tint="@color/md_onPrimaryContainer" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MQTT 连接"
                            android:textColor="@color/md_onSurface"
                            android:textSize="@dimen/sp_15"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="关闭后不再发起任何 MQTT 请求"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="@dimen/sp_12" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchRemote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="远程控制服务开关"
                        android:thumbTint="@color/switch_thumb_mqtt"
                        android:trackTint="@color/switch_track_mqtt"
                        app:useMaterialThemeColors="false" />
                </LinearLayout>

                <!-- 快照状态提示（由 OverviewFragment 动态控制显隐） -->
                <TextView
                    android:id="@+id/tvSnapshotHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="@dimen/sp_12"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

            <!-- 需求：设备卡状态灯颜色图例（小字说明） -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/md_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/md_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_sphere_online" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="在线"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_sphere_pairing" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="配对中"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_sphere_offline" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="离线/解绑"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_sphere_error" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="失败"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        <!-- D3：缓存数据可能已过期的灰色细条提示 -->
        <TextView
            android:id="@+id/tvStaleStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/md_surfaceVariant"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="缓存数据 · 可能已过期"
            android:textColor="@color/md_onSurfaceVariant"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ============ 2. 快捷操作（2×3 图标网格，v1.2 重构） ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/Widget.Daily.SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="快捷操作"
                    android:textColor="@color/md_onSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="远程触发被控端动作"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="12sp" />

                <!-- 2×3 图标网格 -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="3"
                    android:rowCount="2">

                    <!-- 手动打卡 -->
                    <LinearLayout
                        android:id="@+id/btnActPunch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_action_tile"
                        android:backgroundTint="@color/md_primaryContainer"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/md_primary" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="手动打卡"
                            android:textSize="11sp" android:textColor="@color/md_onPrimaryContainer" />
                    </LinearLayout>

                    <!-- 考勤记录 -->
                    <LinearLayout
                        android:id="@+id/btnActAttendance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_action_tile"
                        android:backgroundTint="@color/md_tertiaryContainer"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_scan"
                            app:tint="@color/md_tertiary" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="考勤记录"
                            android:textSize="11sp" android:textColor="@color/md_onTertiaryContainer" />
                    </LinearLayout>

                    <!-- 执行任务 -->
                    <LinearLayout
                        android:id="@+id/btnActStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_action_tile"
                        android:backgroundTint="@color/brand_purple_container"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_power"
                            app:tint="@color/brand_purple" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="执行任务"
                            android:textSize="11sp" android:textColor="@color/brand_on_purple_container" />
                    </LinearLayout>

                    <!-- 终止任务（红色） -->
                    <LinearLayout
                        android:id="@+id/btnActStop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_action_tile"
                        android:backgroundTint="@color/md_errorContainer"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_close"
                            app:tint="@color/md_error" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="终止任务"
                            android:textSize="11sp" android:textColor="@color/md_onErrorContainer" />
                    </LinearLayout>

                    <!-- 开启循环 -->
                    <LinearLayout
                        android:id="@+id/btnActLoopOn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_action_tile"
                        android:backgroundTint="@color/md_successContainer"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_loop"
                            app:tint="@color/md_success" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="开启循环"
                            android:textSize="11sp" android:textColor="@color/md_onSuccessContainer" />
                    </LinearLayout>

                    <!-- 关闭循环 -->
                    <LinearLayout
                        android:id="@+id/btnActLoopOff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_action_tile"
                        android:backgroundTint="@color/md_errorContainer"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_loop"
                            app:tint="@color/md_error" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="关闭循环"
                            android:textSize="11sp" android:textColor="@color/md_onErrorContainer" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 4. 运行概览 ============ -->
        <TextView style="@style/SectionTitle" android:text="运行概览" />

        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                style="@style/SectionBody"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView 
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_circle_secondary"
                        android:padding="10dp"
                        android:src="@drawable/ic_power_save"
                        app:tint="@color/md_onSecondaryContainer" android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvBatteryPct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textColor="@color/md_onSurface"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBatteryCharging"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="--"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBattery"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:progress="0"
                        app:indicatorColor="@color/md_primary"
                        app:trackColor="@color/md_surfaceVariant"
                        app:trackThickness="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/chipForeground"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="前台服务" />

                    <TextView
                        android:id="@+id/chipScheduler"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="任务调度" />

                    <TextView
                        android:id="@+id/chipPowerSave"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="省电模式" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/chipPseudo"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="伪息屏" />

                    <TextView
                        android:id="@+id/chipWifi"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="WiFi" />

                    <TextView
                        android:id="@+id/chipBluetooth"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="蓝牙" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/chipLoop"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="每日循环" />

                    <TextView
                        android:id="@+id/chipNextReset"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="下次重置" />

                    <TextView
                        android:id="@+id/chipServiceRun"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:text="服务运行" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/chipDeviceTime"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:text="设备时间 --" />

                    <TextView
                        android:id="@+id/chipTemperature"
                        style="@style/InfoChip"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:text="电池温度 --" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chipScheduleDesc"
                    style="@style/InfoChip"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:text="暂无调度描述" />

                <TextView
                    android:id="@+id/chipDisconnect"
                    style="@style/InfoChip"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:text="今日 0 次掉线" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 5. 打卡概览（首屏保留） ============ -->
        <TextView style="@style/SectionTitle" android:text="打卡概览" />
        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                style="@style/SectionBody"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/tvPunchPunched" style="@style/StatNum" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="已打卡" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/tvPunchScheduled" style="@style/StatNum" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="计划" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatBox">
                        <TextView android:id="@+id/tvPunchMissed" style="@style/StatNum" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="未计划" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/SectionBody" android:layout_marginTop="@dimen/dp_12">
                    <include layout="@layout/row_info" android:id="@+id/rowNext" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowRecent" />
                    <View style="@style/Divider" />
                    <include layout="@layout/row_info" android:id="@+id/rowToday" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 电池趋势（由「更多信息」提升为首屏常驻区块） ============ -->
        <TextView style="@style/SectionTitle" android:text="电池趋势" />
        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                style="@style/SectionBody"
                android:orientation="vertical">

                <com.yample.daily.controller.BatterySparkView
                    android:id="@+id/batterySpark"
                    android:layout_width="match_parent"
                    android:layout_height="96dp" />

                <TextView
                    android:id="@+id/tvBatteryTrend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="—"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/layoutBatteryPredict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/bg_warning_rounded"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivBatteryPredictIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_battery_warning"
                        app:tint="@color/md_warning" />

                    <TextView
                        android:id="@+id/tvBatteryPredict"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/md_onWarningContainer" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 最近指令（由「更多信息」提升为首屏常驻区块） ============ -->
        <TextView style="@style/SectionTitle" android:text="最近指令" />
        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                android:id="@+id/layoutRecentCmds"
                style="@style/SectionBody"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 设备告警（被控端上报的事件告警历史） ============ -->
        <TextView style="@style/SectionTitle" android:text="设备告警" />
        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">
            <LinearLayout
                style="@style/SectionBody"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAlertsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="暂无告警，被控端低电量 / 充电 / 充满等事件将在此记录"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layoutAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAlertsClear"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="清空告警记录"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
